# Copy to .env.local on the operator machine. Never commit real values.
# Preview and production values belong in the Vercel project, not in git.
# Do not change Vercel environment variables from an agent turn.
# Do not upgrade Neon off the Free plan.

# Operator machine only, for AMC_TARGET=production commands.
# Hosted preview must not receive DATABASE_URL, BLOB_STORE_ID, or a Blob token.
# If production DATA_STORE or MEDIA_STORE is missing, /api/access returns 503.
DATA_STORE=postgres
MEDIA_STORE=blob
DATABASE_URL=
# Production and preview must not share this database. Preview must not have
# DATABASE_URL, BLOB_STORE_ID, or a Blob token. Export AMC_TARGET=production
# in the shell only when these values came from Production.
CODE_PEPPER=
# Laptop CLI: read-write token for the same private store. A stale VERCEL_OIDC_TOKEN
# in the shell is ignored unless BLOB_AUTH=oidc.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# SHA-256 hex of the private object at projects/_access/private-canary.
# Required before any project session is issued. Do not commit the object.
BLOB_PRIVATE_CANARY_SHA256=
# BLOB_AUTH=oidc

# Optional rate limit overrides. Invalid values fail closed.
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000

# Preview only. Never set this on Production. The demo code is published in the repo.
# DEMO_FIXTURE=
